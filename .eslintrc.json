{
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": ["plugin:react/recommended", "google", "prettier"],
  "ignorePatterns": [
    "**/*.scss",
    "**/*.png",
    "**/*.svg",
    "dist/**",
    "**/*.ts",
    "**/*.tsx"
  ],
  "overrides": [],
  "parserOptions": {
    "ecmaFeatures": {
      "jsx": true
    },
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "plugins": ["react"],
  "rules": {
    "new-cap": [
      "error",
      {
        "capIsNewExceptions": ["Cell"]
      }
    ],
    "no-console": "error",
    "react/jsx-uses-react": "off",
    "react/react-in-jsx-scope": "off",
    "valid-jsdoc": "off"
  },
  "settings": {
    "react": {
      "version": "detect"
    }
  }
}
